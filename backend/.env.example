# Backend configuration overrides
PORT=1313
DATABASE_URI=mongodb://mongo:27017/debateai
REDIS_ADDR=redis:6379

# External service credentials and application secrets
GEMINI_API_KEY=your-gemini-api-key
JWT_SECRET=replace-with-a-long-random-secret
GOOGLE_CLIENT_ID=your-google-client-id

# AI request limit per authenticated user across all protected AI endpoints.
LLM_RATE_LIMIT_MAX=10
LLM_RATE_LIMIT_WINDOW_SECONDS=60
